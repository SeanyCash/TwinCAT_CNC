    ERRID   => );
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_NCLine" Id="{6cd17ca0-d2c2-4cc1-ba9e-49c22a1598c4}">
      <Declaration><![CDATA[METHOD M_NCLine : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbADSRead(
    NETID    := ,
