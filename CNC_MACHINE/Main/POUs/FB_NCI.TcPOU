<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_NCI" Id="{1f9317fb-89ce-40e9-b891-79ee2db60d9f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NCI IMPLEMENTS I_HMI;
VAR_INPUT
	eRequestedState		: E_MachineState;
	sPrgName			: STRING(255);
	bEnable				: BOOL;
	bStop               : BOOL;
END_VAR
VAR_OUTPUT
	eActiveRequest		: E_MachineState;
	bStateDone			: BOOL;
	bError				: BOOL;
	sErrorText			: STRING(80);
	sLoadedProgram		: STRING;
	out_stItpToPlc		: NCTOPLC_NCICHANNEL_REF;
	bSetSpindleSpeed	: BOOL;
	bEnableDustCollector : BOOL;
	eCurrentState		: E_MachineState;
END_VAR
VAR_IN_OUT
	stX					: AXIS_REF;
	stY					: AXIS_REF;
	stZ					: AXIS_REF;
END_VAR
VAR
	bStateEntry			: BOOL;
	bNewRequest			: BOOL;
	fbSpindle			: FB_SpindleFunctions;
	bSpindleAtSpeed		: BOOL;
	bSpindleActive		: BOOL;
	bSpindleStopped		: BOOL;
	nInterpreterState	: UDINT := 0;
	nErrorState			: UDINT;
	fChannelOverride	: REAL;
	bConfirmHsk			: BOOL := FALSE;
	fbMessage			: FB_TcMessage;
	fbBuildGroup		: CfgBuildExt3DGroup;
	fbLoadGCode			: ItpLoadProgEx;
	fbStartStopGCode	: ItpStartStopEx;
	fbClearGroup		: CfgReconfigGroup;
	fbConfirmMCodeHsk	: ItpConfirmHsk;
	fbItpReset		: ItpResetEx2;
	bHskBusy			: BOOL;
	bHskError			: BOOL;
	nHskErrorID			: UDINT;
	fbZeroShiftOffset	: ItpWriteZeroShiftEx;
	fbReadZeroShiftOffset : ItpReadZeroShiftEx;
	bExecuteZeroShift	: BOOL;
	bZeroShiftWriteBusy	: BOOL;
	bReadZeroShift		: BOOL;
	nZeroShiftNumber	: UDINT := 54;
	bSpindleSpeedSet	: BOOL;
	nMCodeSeq			: INT;
	rTrigMHandshake		: R_TRIG;
	rTrigM05			: R_TRIG;
	tMCodePulse			: TP;
	tHskPulse			: TP;
	bSpindleEnableTest	: BOOL;
	bSpindleEnableDone	: BOOL;
	bSpindleSetSpeedTest : BOOL;
	bSpindleSetSpeedDone : BOOL;
	fbADSRead			: ADSREADEX;
	fbADSWrite			: ADSWRITE;
	sReadNCLine			: STRING[255];
	bReadNCLineExecute	: BOOL;
	sReadNCName			: STRING[100];
	bReadNCNameExec		: BOOL;
	sReadNCFileInfo		: STRING;
	NC_In				: ST_Interpreter_Inputs;
	NC_Out				: ST_Interpreter_Outputs;
	eInterpreterState	: E_InterpreterState;
	i_stItpToPlc	AT %I* : NcToPlc_NciChannel_Ref;
	q_stPlcToItp	AT %Q* : PLCTONC_NCICHANNEL_REF;
	stItpToPlc		: NCTOPLC_NCICHANNEL_REF;
	fbAlarm			: FB_TcAlarm;
	bSendEvent		: BOOL;
	bInitEvent		: BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ── Always-running methods (HMI, diagnostics, hardware) ─────────────────────
M_InterpreterState();
M_NCName();
M_NCLine();
M_HMI_In();
M_HMI_Out();
M_SetOverride();
M_MCodeFunctions();
M_ZeroShiftOffset();

// ── Spindle runs every scan ──────────────────────────────────────────────────
fbSpindle(nSpindleSpeedFromNC := stItpToPlc.SpindleRpm,
          bSpindleAtRequestedSpeed => bSpindleAtSpeed);

// ── Map hardware channel ─────────────────────────────────────────────────────
stItpToPlc    := i_stItpToPlc;
out_stItpToPlc := i_stItpToPlc;

// ── Zero shift capture ───────────────────────────────────────────────────────
IF bExecuteZeroShift AND (nZeroShiftNumber >= 54 AND nZeroShiftNumber <= 57) THEN
    NC_In.ZeroShiftDesc[nZeroShiftNumber].fShiftX := stX.NcToPlc.ActPos;
    NC_In.ZeroShiftDesc[nZeroShiftNumber].fShiftY := stY.NcToPlc.ActPos;
    NC_In.ZeroShiftDesc[nZeroShiftNumber].fShiftZ := stZ.NcToPlc.ActPos;
END_IF

IF bSpindleEnableTest THEN
    bSpindleEnableDone := fbSpindle.M_Enable(bExecute := bSpindleEnableTest);
    IF bSpindleEnableDone THEN
        bSpindleEnableTest := FALSE;
    END_IF
END_IF

// ============================================================================
//  PackML Unit Dispatch
//  Routes eActiveRequest to the correct state method.
//  bStateEntry is TRUE only on the first scan of each new request.
// ============================================================================
CASE eActiveRequest OF

    E_MachineState.RESETTING  : Resetting();
    E_MachineState.STARTING   : Starting();
    E_MachineState.EXECUTE    : Execute();
    E_MachineState.HOLDING    : Holding();
    E_MachineState.COMPLETING : Completing();
    E_MachineState.STOPPING   : Stopping();
    E_MachineState.ABORTING   : Aborting();

    // Resting states — confirm immediately, no work needed
    E_MachineState.IDLE,
    E_MachineState.HELD,
    E_MachineState.STOPPED,
    E_MachineState.COMPLETE,
    E_MachineState.ABORTED    : bStateDone := TRUE;

END_CASE

// ============================================================================
//  POST-PROCESSING — runs AFTER CASE every scan
//
//  New request detection and bStateDone := FALSE happen here.
//  Guarantees bStateDone=FALSE is visible to Controller for one full scan
//  before any state method can set it TRUE.
// ============================================================================
bNewRequest := (eRequestedState <> eActiveRequest);

IF bNewRequest THEN
    eActiveRequest  := eRequestedState;
    bStateDone      := FALSE;
    bStateEntry     := TRUE;
    bError          := FALSE;
    sErrorText      := '';
ELSE
    bStateEntry     := FALSE;
END_IF

// HMI mirror
eCurrentState  := eActiveRequest;
sLoadedProgram := sPrgName;
]]></ST>
    </Implementation>
    <Folder Name="State Machine" Id="{c979d79d-baf4-4c01-b551-a129515ca700}" />
    <Method Name="Aborting" Id="{bfa9b5bc-fe59-4b6e-ada2-3dd391b4c4c9}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Aborting : BOOL
VAR_INST
	nSeq	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Immediate kill — do not wait for orderly ramp-down
fbStartStopGCode(bStart := FALSE, bStop := TRUE, sNciToPlc := stItpToPlc);
fbClearGroup(bExecute := TRUE, nGroupId := ItpGetGroupId(sNciToPlc := stItpToPlc));
bGearOutExecute := TRUE;

fbMessage.CreateEx(TC_Events.CNC_Events.NC_Execute_Failed, 0);
fbMessage.Send(0);

bStateDone := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Completing" Id="{1a5a1482-aa93-4cbe-99d2-7befb04234db}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Completing : BOOL
VAR_INST
	nSeq		: UINT;
	nLastSeq	: UINT;
	bStepEntry	: BOOL;
	tStepTimer	: TON;
	bTimeoutEnable : BOOL;
	sErrorText	: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tStepTimer(IN := (bTimeoutEnable AND NOT bStepEntry), PT := T#400S);

CASE nSeq OF

    0:  // ── Gear out ────────────────────────────────────────────────────────
        IF bStepEntry THEN
            bGearInExecute := FALSE;
            bGearOutExecute := TRUE;
            bTimeoutEnable  := TRUE;
        END_IF

        IF fbCNC.Y_MC_OUT.bGearOutDone AND (fbCNC.Y_Ref.NcToPlc.CoupleState = 0) THEN
            bGearOutExecute := FALSE;
            bTimeoutEnable  := FALSE;
            nSeq := 10;
        ELSIF tStepTimer.Q THEN
            bGearOutExecute := FALSE;
            nErrorState := 0; sErrorText := 'Completing: Y gear-out timeout'; nSeq := 9999;
        END_IF

    10: // ── Clear interpolation group ────────────────────────────────────────
        fbClearGroup(bExecute := bStepEntry,
                     nGroupId := ItpGetGroupId(sNciToPlc := stItpToPlc),
                     tTimeOut := T#5S);

        IF NOT fbClearGroup.bBusy THEN
            fbClearGroup(bExecute := FALSE);
            IF NOT fbClearGroup.bErr THEN
                nSeq := 9000;
            ELSE
                nErrorState := 10; sErrorText := 'Completing: ClearGroup failed'; nSeq := 9999;
            END_IF
        END_IF

    9000: // ── Done ─────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        bStateDone     := TRUE;
        fbMessage.CreateEx(TC_Events.CNC_Events.NC_Execute_Finished, 0);
        fbMessage.Send(0);

    9999: // ── Fault ────────────────────────────────────────────────────────
        bTimeoutEnable  := FALSE;
        fbClearGroup(bExecute := FALSE);
        bError          := TRUE;
        sErrorText      := sErrorText;

END_CASE

bStepEntry := (nSeq <> nLastSeq);
nLastSeq   := nSeq;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Execute" Id="{5d224993-f01d-4b55-9669-c4efb2d9e395}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INST
	nSeq			: UINT;
	nLastSeq		: UINT;
	bStepEntry		: BOOL;
	tStepTimer		: TON;
	bTimeoutEnable	: BOOL;
	sErrorText		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Timeout timer — unconditional, armed by bTimeoutEnable
tStepTimer(IN := (bTimeoutEnable AND NOT bStepEntry), PT := T#400S);

// ============================================================================
// Execute State Logic
// ============================================================================
CASE nSeq OF

    0:  // ── Wait for interpreter to leave Ready ─────────────────────────────
        // Guards against declaring done before the program has actually launched.
        IF bStepEntry THEN
            bTimeoutEnable := TRUE;
        END_IF

        nInterpreterState := ItpGetStateInterpreter(sNciToPlc := stItpToPlc);

        IF nInterpreterState <> Tc2_NCI.NCI_INTERPRETER_READY THEN
            bTimeoutEnable := FALSE;
            nSeq := 10;
        ELSIF tStepTimer.Q THEN
            nErrorState := 0; sErrorText := 'Interpreter never left Ready'; nSeq := 9999;
        END_IF

    10: // ── Monitor — wait for program to finish ─────────────────────────────
        nInterpreterState := ItpGetStateInterpreter(sNciToPlc := stItpToPlc);

        IF nInterpreterState = Tc2_NCI.NCI_INTERPRETER_READY THEN
            nSeq := 9000;
        ELSIF nInterpreterState = Tc2_NCI.NCI_INTERPRETER_ABORTED THEN
            nErrorState := 10; sErrorText := 'Interpreter aborted mid-run'; nSeq := 9999;
        END_IF

    9000: // ── Done ─────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        bStateDone     := TRUE;

    9999: // ── Fault ────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        bError         := TRUE;
        sErrorText     := sErrorText;

END_CASE

// ── Housekeeping ─────────────────────────────────────────────────────────────
bStepEntry := (nSeq <> nLastSeq);
nLastSeq   := nSeq;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Holding" Id="{a3987914-c173-460d-98b9-6b689ccfdfdf}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Holding : BOOL
VAR_INST
	nSeq	: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Feed hold — suspend motion, maintain spindle
// Replace with real feed-hold FB call when available
// Spindle stays running during hold (M3 still active)
bStateDone := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HMI_In" Id="{38563b67-eb50-4e81-add6-bb0c60e243d4}">
      <Declaration><![CDATA[METHOD M_HMI_In : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Set NC Channel Override Speed
fChannelOverride := stHMI_In.fChannelOverride;

// Spindle Override Speed
q_stPlcToItp.ChnSpindleOvr := stHMI_In.fSpindleOverrideSpeed;

// Zero Shift Offset
bExecuteZeroShift := stHMI_In.bExecuteZeroShift;
nZeroShiftNumber  := stHMI_In.nZeroShiftNumber;
bReadZeroShift    := stHMI_In.bReadZeroShift;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HMI_Out" Id="{a7ce7f7c-2885-4578-a30d-e34fbb054eb5}">
      <Declaration><![CDATA[METHOD M_HMI_Out : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Interpreter Channel State
stHMI_Out.sInterpreterState := TO_STRING(eInterpreterState);

// Channel Override Speed
stHMI_Out.fChannelOverrideSpeed := fChannelOverride;

IF i_stItpToPlc.PathVelo <> 0 THEN
    stHMI_Out.fToolpathVelocityIPM := (i_stItpToPlc.PathVelo / 0.42);
ELSE
    stHMI_Out.fToolpathVelocityIPM := 0.0;
END_IF

// Interpreter Status to HMI
stHMI_Out.stItpToPlc := i_stItpToPlc;

stHMI_Out.ZeroShiftDesc[54] := NC_In.ZeroShiftDesc[54];
stHMI_Out.ZeroShiftDesc[55] := NC_In.ZeroShiftDesc[55];
stHMI_Out.ZeroShiftDesc[56] := NC_In.ZeroShiftDesc[56];
stHMI_Out.ZeroShiftDesc[57] := NC_In.ZeroShiftDesc[57];

// NC program info
stHMI_Out.sReadNCLine := sReadNCLine;
stHMI_Out.sReadNCName := sReadNCName;

// Current M Code
stHMI_Out.nCurrentMCode := ItpGetHskMFunc(sNciToPlc := stItpToPlc);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_InterpreterState" Id="{b9d1ee92-b98c-4639-9cc3-4d58c18664b9}">
      <Declaration><![CDATA[METHOD M_InterpreterState : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[eInterpreterState := i_stItpToPlc.ItpState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_MCodeFunctions" Id="{5a349b52-5ebd-4db2-bb7d-e7cd9ae2a914}">
      <Declaration><![CDATA[METHOD M_MCodeFunctions : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// M code Handshakes
fbConfirmMCodeHsk(
	bExecute  := tHskPulse.Q,
	sNciToPlc := stItpToPlc,
	sPlcToNci := q_stPlcToItp,
	bBusy     => bHskBusy,
	bErr      => ,
	nErrId    => );

// Get Current M Code
nMCodeSeq := ItpGetHskMFunc(sNciToPlc := stItpToPlc);

CASE nMCodeSeq OF

    0:
        bConfirmHsk        := FALSE;
        bSpindleActive     := FALSE;
        bSpindleStopped    := FALSE;
        tMCodePulse(IN := FALSE);
        tHskPulse(IN := FALSE);
        bEnableDustCollector := FALSE;

    3:
        IF NOT bSpindleActive THEN
            tMCodePulse(IN := TRUE, PT := T#300MS);
            bSpindleActive := fbSpindle.M_SetSpeed(bExecute := tMCodePulse.Q);
        END_IF
        IF bSpindleActive THEN
            bEnableDustCollector := TRUE;
            tHskPulse(IN := TRUE, PT := T#200MS);
            tMCodePulse(IN := FALSE);
        ELSE
            tHskPulse(IN := FALSE);
        END_IF

    5:
        IF NOT bSpindleStopped THEN
            tMCodePulse(IN := TRUE, PT := T#300MS);
            bSpindleStopped := fbSpindle.M_CoastStop(bExecute := tMCodePulse.Q);
        END_IF
        IF bSpindleStopped THEN
            bEnableDustCollector := FALSE;
            tHskPulse(IN := TRUE, PT := T#200MS);
            tMCodePulse(IN := FALSE);
        ELSE
            tHskPulse(IN := FALSE);
        END_IF

END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_NCFileInfo" Id="{c419ebe8-598b-4477-ba91-7465557261c2}">
      <Declaration><![CDATA[METHOD M_NCFileInfo : BOOL
