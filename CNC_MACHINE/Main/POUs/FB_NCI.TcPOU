    ERRID    => );
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_NCName" Id="{8f1ba72e-e16f-46aa-ae38-b94b4cef5464}">
      <Declaration><![CDATA[METHOD M_NCName : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sLoadedProgram := sPrgName;

fbADSRead(
    NETID    := ,
    PORT     := 500,
    IDXGRP   := 16#2102,
    IDXOFFS  := 16#7,
    LEN      := SIZEOF(sReadNCName),
    DESTADDR := ADR(sReadNCName),
