]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetOverride" Id="{79a038bc-12ad-40d2-8377-2a6c704a7bc1}">
      <Declaration><![CDATA[METHOD M_SetOverride : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ItpSetOverridePercent(fOverridePercent := fChannelOverride, sPlcToNci := q_stPlcToItp);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ZeroShiftOffset" Id="{90ff0815-f665-4c74-9803-2c6ddd723008}">
      <Declaration><![CDATA[METHOD M_ZeroShiftOffset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF nZeroShiftNumber <> 0 THEN
    fbZeroShiftOffset(
        bExecute      := bExecuteZeroShift,
        nZsNo         := nZeroShiftNumber,
        tTimeOut      := ,
        sNciToPlc     := stItpToPlc,
        sZeroShiftDesc := NC_In.ZeroShiftDesc[nZeroShiftNumber],
        bBusy         => bZeroShiftWriteBusy,
        bErr          => ,
        nErrId        => );
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Resetting" Id="{9f822867-2e6e-46d2-aeaf-275effff965a}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Resetting : BOOL
VAR_INST
    nSeq            : UINT;
    nLastSeq        : UINT;
    bStepEntry      : BOOL;
    tStepTimer      : TON;
    bTimeoutEnable  : BOOL;
    sErrorText      : STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Timeout timer — runs unconditionally, armed by bTimeoutEnable
// bStepEntry forces it off for one scan on step entry (guaranteed reset)
tStepTimer(IN := (bTimeoutEnable AND NOT bStepEntry), PT := T#30S);

IF bStateEntry THEN
    nSeq     := 0;
    nLastSeq := 65535;
END_IF

// ============================================================================
// Resetting State Logic
// ============================================================================
CASE nSeq OF

	0:  // ── Force Y gear-out first ───────────────────────────────────────────
		IF bStepEntry THEN
			bGearOutExecute := TRUE;
			bTimeoutEnable  := TRUE;
		END_IF
		IF fbCNC.Y_MC_OUT.bGearOutDone AND (fbCNC.Y_Ref.NcToPlc.CoupleState = 0) THEN
			bGearOutExecute := FALSE;
			bTimeoutEnable  := FALSE;
			nSeq := 5;
		ELSIF tStepTimer.Q THEN
			bGearOutExecute := FALSE;
			nErrorState := 0; sErrorText := 'Resetting: Y gear-out timeout'; nSeq := 9999;
		END_IF
	
	5:  // ── Deactivate all NCI FBs ───────────────────────────────────────────
		fbStartStopGCode(bStart := FALSE, sNciToPlc := stItpToPlc);
		fbLoadGCode(bExecute := FALSE, sNciToPlc := stItpToPlc);
		fbClearGroup(bExecute := FALSE);
		fbBuildGroup(bExecute := FALSE);
		nSeq := 10;

    10: // ── Reset NCI interpolator ───────────────────────────────────────────
        fbItpReset(
            bExecute  := bStepEntry,
            tTimeOut  := T#5S,
            sNciToPlc := stItpToPlc
        );

        IF NOT fbItpReset.bBusy THEN
            fbItpReset(bExecute := FALSE, sNciToPlc := stItpToPlc);
            IF NOT fbItpReset.bErr THEN
                nSeq := 20;
            ELSE
                nErrorState := 10; sErrorText := 'ItpResetEx2 failed'; nSeq := 9999;
            END_IF
        END_IF

    20: // ── Verify interpreter idle ──────────────────────────────────────────
        IF bStepEntry THEN
            bTimeoutEnable := TRUE;
        END_IF
        nInterpreterState := ItpGetStateInterpreter(sNciToPlc := stItpToPlc);
        IF nInterpreterState = Tc2_NCI.NCI_INTERPRETER_IDLE THEN
            bTimeoutEnable := FALSE;
            nSeq := 9000;
        ELSIF tStepTimer.Q THEN
            nErrorState := 20; sErrorText := 'Interpreter idle timeout'; nSeq := 9999;
        END_IF

    9000: // ── Done ─────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        bStateDone     := TRUE;

    9999: // ── Fault ────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        fbStartStopGCode(bStart := FALSE, sNciToPlc := stItpToPlc);
        fbLoadGCode(bExecute := FALSE, sNciToPlc := stItpToPlc);
        fbClearGroup(bExecute := FALSE);
        fbBuildGroup(bExecute := FALSE);
        fbItpReset(bExecute := FALSE, sNciToPlc := stItpToPlc);
        bError     := TRUE;
        sErrorText := sErrorText;

END_CASE

// ── Housekeeping ─────────────────────────────────────────────────────────────
bStepEntry := (nSeq <> nLastSeq);
nLastSeq   := nSeq;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{96e973ad-a000-4f44-8176-5f0e734fe90a}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Starting : BOOL
VAR_INST
	nSeq			: UINT;
	nLastSeq		: UINT;
	bStepEntry		: BOOL;
	tStepTimer		: TON;
	bTimeoutEnable	: BOOL;
	sErrorText		: STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Timeout timer — runs unconditionally, armed by bTimeoutEnable
// bStepEntry forces it off for one scan on step entry (guaranteed reset)
tStepTimer(IN := (bTimeoutEnable AND NOT bStepEntry), PT := T#400S);

IF bStateEntry THEN
    nSeq     := 0;
    nLastSeq := 65535;
END_IF

// ============================================================================
// Starting State Logic
// ============================================================================
CASE nSeq OF

    0:  // ── Init + kick off Y gear-out ──────────────────────────────────────
        IF bStepEntry THEN
            bGearOutExecute  := TRUE;
            bTimeoutEnable   := TRUE;
        END_IF

        IF fbCNC.Y_MC_OUT.bGearOutDone THEN
            bGearOutExecute := FALSE;
            bTimeoutEnable  := FALSE;
            nSeq := 5;
        ELSIF tStepTimer.Q THEN
            nErrorState := 0; sErrorText := 'Y gear-out timeout'; nSeq := 9999;
        END_IF

    5:  // ── Clear interpolation group ────────────────────────────────────────
        fbClearGroup(bExecute := bStepEntry, nGroupId := ItpGetGroupId(sNciToPlc := stItpToPlc));

        IF NOT fbClearGroup.bBusy THEN
            fbClearGroup(bExecute := FALSE);
            IF NOT fbClearGroup.bErr THEN
                nSeq := 10;
            ELSE
                nErrorState := 5; sErrorText := 'ClearGroup failed'; nSeq := 9999;
            END_IF
        END_IF

    10: // ── Build interpolation group ────────────────────────────────────────
        fbBuildGroup(bExecute  := bStepEntry,
                     nGroupId  := ItpGetGroupId(sNciToPlc := stItpToPlc),
                     nXAxisId  := stX.NcToPlc.AxisId,
                     nYAxisId  := stY.NcToPlc.AxisId,
                     nZAxisId  := stZ.NcToPlc.AxisId,
                     nQ1AxisId := 0, nQ2AxisId := 0, nQ3AxisId := 0,
                     nQ4AxisId := 0, nQ5AxisId := 0);

        IF NOT fbBuildGroup.bBusy THEN
            fbBuildGroup(bExecute := FALSE);
            IF NOT fbBuildGroup.bErr THEN
                nSeq := 15;
            ELSE
                nErrorState := 10; sErrorText := 'BuildGroup failed'; nSeq := 9999;
            END_IF
        END_IF

    15: // ── Check Y couple state ─────────────────────────────────────────────
        IF fbCNC.Y_Ref.NcToPlc.CoupleState = 1 THEN
            nSeq := 20;
        ELSE
            bGearInExecute   := TRUE;
            bTimeoutEnable   := TRUE;
            nSeq := 16;
        END_IF

    16: // ── Wait for Y gear-in ───────────────────────────────────────────────
        IF fbCNC.Y_MC_OUT.bGearInDone AND (fbCNC.Y_Ref.NcToPlc.CoupleState = 1) THEN
            bGearInExecute := FALSE;
            bTimeoutEnable := FALSE;
            nSeq := 20;
        ELSIF tStepTimer.Q THEN
            bGearInExecute := FALSE;
            nErrorState := 16; sErrorText := 'Y gear-in timeout'; nSeq := 9999;
        END_IF

    20: // ── Load G-code ──────────────────────────────────────────────────────
        fbLoadGCode(bExecute  := bStepEntry,
                    sPrg      := sPrgName,
                    sNciToPlc := stItpToPlc,
                    nLength   := INT_TO_UDINT(LEN(sPrgName)),
                    tTimeOut  := T#10S);

        IF NOT fbLoadGCode.bBusy THEN
            fbLoadGCode(sNciToPlc := stItpToPlc, bExecute := FALSE);
            IF NOT fbLoadGCode.bErr THEN
                nSeq := 30;
            ELSE
                nErrorState := 20; sErrorText := 'LoadGCode failed'; nSeq := 9999;
            END_IF
        END_IF

    30: // ── Verify interpreter ready ─────────────────────────────────────────
        IF bStepEntry THEN
            bTimeoutEnable := TRUE;
        END_IF
        nInterpreterState := ItpGetStateInterpreter(sNciToPlc := stItpToPlc);
        IF nInterpreterState = Tc2_NCI.NCI_INTERPRETER_READY THEN
            bTimeoutEnable := FALSE;
            nSeq := 40;
        ELSIF tStepTimer.Q THEN
            nErrorState := 30; sErrorText := 'Interpreter ready timeout'; nSeq := 9999;
        END_IF

    40: // ── Start G-code ─────────────────────────────────────────────────────
        fbStartStopGCode(bStart    := bStepEntry,
                         bStop     := FALSE,
                         tTimeOut  := T#5S,
                         sNciToPlc := stItpToPlc);

        IF NOT fbStartStopGCode.bBusy THEN
            fbStartStopGCode(bStart := FALSE, sNciToPlc := stItpToPlc);
            IF NOT fbStartStopGCode.bErr THEN
                nSeq := 9000;
            ELSE
                nErrorState := 40; sErrorText := 'NC Start failed'; nSeq := 9999;
            END_IF
        END_IF

    9000: // ── Done ─────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        bStateDone     := TRUE;

    9999: // ── Fault ────────────────────────────────────────────────────────
        bTimeoutEnable := FALSE;
        fbClearGroup(bExecute := FALSE);
        fbBuildGroup(bExecute := FALSE);
        fbLoadGCode(bExecute := FALSE, sNciToPlc := stItpToPlc);
        fbStartStopGCode(bStart := FALSE, sNciToPlc := stItpToPlc);
        bError     := TRUE;
        sErrorText := sErrorText;   // already set by guilty step

END_CASE

// ── Housekeeping ─────────────────────────────────────────────────────────────
bStepEntry := (nSeq <> nLastSeq);
nLastSeq   := nSeq;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopping" Id="{826e854e-8b2f-4a5f-ab15-b099ec26b3b7}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD Stopping : BOOL
VAR_INST
	nSeq		: UINT;
	nLastSeq	: UINT;
	bStepEntry	: BOOL;
	tStepTimer	: TON;
	bTimeoutEnable : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tStepTimer(IN := (bTimeoutEnable AND NOT bStepEntry), PT := T#10S);

CASE nSeq OF

    0:  // ── Send stop command ────────────────────────────────────────────────
        fbStartStopGCode(bStart := FALSE, bStop := bStepEntry, sNciToPlc := stItpToPlc, tTimeOut := T#10S);

        IF NOT fbStartStopGCode.bBusy THEN
            fbStartStopGCode(bStop := FALSE, sNciToPlc := stItpToPlc);
            IF NOT fbStartStopGCode.bErr THEN
                nSeq := 9000;
            ELSE
                nSeq := 9999;
            END_IF
        END_IF

    9000: // ── Done ─────────────────────────────────────────────────────────
        bStateDone := TRUE;

    9999: // ── Fault ────────────────────────────────────────────────────────
        fbStartStopGCode(bStop := FALSE, sNciToPlc := stItpToPlc);
        bError     := TRUE;
        sErrorText := 'Stopping: NC stop command failed';

END_CASE

bStepEntry := (nSeq <> nLastSeq);
nLastSeq   := nSeq;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>