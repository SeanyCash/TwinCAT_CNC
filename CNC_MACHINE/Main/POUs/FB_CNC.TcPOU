<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_CNC" Id="{96a27fad-16a6-48a6-8015-980bd366c343}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CNC IMPLEMENTS I_HMI
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	// ── PackML Controller ────────────────────────────────────────────────────
	eRequestedState     : E_MachineState := E_MachineState.STOPPED;
	eCurrentState       : E_MachineState;   // HMI mirror only
	bAllSynced          : BOOL;
	sBlockedBy          : STRING(80);
	bHandshakeTimeout   : BOOL;
	tonWatchdog         : TON;
	sErrorMsg           : STRING(80);

	// ── Events ───────────────────────────────────────────────────────────────
	fbEventLogger       : FB_TcEventLogger;
	fbAlarm             : FB_TcAlarm;
	fbMessage           : FB_TcMessage;
	bSendEvent          : BOOL;
	bInitEvent          : BOOL;

	// ── Motion ───────────────────────────────────────────────────────────────
	Y_Motion            : FB_MotionFunctions;
	Y2_Motion           : FB_MotionFunctions;
	X_Motion            : FB_MotionFunctions;
	Z_Motion            : FB_MotionFunctions;
	fbNCI               : FB_NCI;

	eHomeYSeq : (INIT_HOME, GEAR_IN, POWER_ON, CHECK_HOMED, HOME_Y1, Y1_HOMED, HOME_Y2, Y2_HOMED, RE_GEAR, HOME_COMPLETE);

	Y_MC_IN             : ST_Motion_Inputs;
	Y2_MC_IN            : ST_Motion_Inputs;
	X_MC_IN             : ST_Motion_Inputs;
	Z_MC_IN             : ST_Motion_Inputs;
	Y_MC_OUT            : ST_Motion_Outputs;
	Y2_MC_OUT           : ST_Motion_Outputs;
	X_MC_OUT            : ST_Motion_Outputs;
	Z_MC_OUT            : ST_Motion_Outputs;

	Y_Ref               : AXIS_REF;
	Y2_Ref              : AXIS_REF;
	X_Ref               : AXIS_REF;
	Z_Ref               : AXIS_REF;

	// ── CoE drive temps ──────────────────────────────────────────────────────
	fbYAxisCoEStatus    : FB_EcCoeSdoRead;
	fbY2AxisCoEStatus   : FB_EcCoeSdoRead;
	fbXAxisCoEStatus    : FB_EcCoeSdoRead;
	fbZAxisCoEStatus    : FB_EcCoeSdoRead;
	nYDriveTemp         : INT;
	nY2DriveTemp        : INT;
	nXDriveTemp         : INT;
	nZDriveTemp         : INT;

	// ── Physical I/O ─────────────────────────────────────────────────────────
	i_bYHomingSwitch    AT %I* : BOOL;
	i_bY2HomingSwitch   AT %I* : BOOL;
	i_bYLimitSwitch     AT %I* : BOOL;
	i_bXHomingSwitch    AT %I* : BOOL;
	i_bXLimitSwitch     AT %I* : BOOL;
	i_bZHomingSwitch    AT %I* : BOOL;

	// ── Homing / limit switch signals ────────────────────────────────────────
	bYHomingSwitch      : BOOL;
	bY2HomingSwitch     : BOOL;
	bYLimitSwitch       : BOOL;
	bYNegativeLimit     : BOOL;
	bY2NegativeLimit    : BOOL;
	bXHomingSwitch      : BOOL;
	bZHomingSwitch      : BOOL;
	bXLimitSwitch       : BOOL;
	bXNegativeLimit     : BOOL;
	bZPositiveLimit     : BOOL;

	// ── Dust collector ───────────────────────────────────────────────────────
	bEnableDustCollector    : BOOL;
	bEnableDustCollectorPB  : BOOL;
	q_bEnableDustCollector  AT %Q* : BOOL;

	// ── Limit switch stop triggers ───────────────────────────────────────────
	bYStopTrigger       : R_TRIG;
	bXStopTrigger       : R_TRIG;
	bZStopTrigger       : R_TRIG;

	// ── Homing control ───────────────────────────────────────────────────────
	bHomeY              : BOOL;
	bHomeY2             : BOOL;
	bHomeX              : BOOL;
	bHomeZ              : BOOL;
	bDirectHome         : BOOL;
	eHomingMode         : MC_HomingMode;
	bGearInTrigger      : BOOL;
	bGearOutTrigger     : BOOL;
	rGearInTrigger      : R_TRIG;
	rGearOutTrigger     : R_TRIG;
	rtrigAxisNotGeared  : R_TRIG;
	bAllAxesReady       : BOOL;
	bAllAxesHomed       : BOOL;

	// ── Axis control ─────────────────────────────────────────────────────────
//	bAxisEnable         : BOOL;
//	bAxisReset          : BOOL;
	trigAxisEnable      : R_TRIG;
	trigProgramCall     : R_TRIG;

	// ── Operator commands ────────────────────────────────────────────────────
	bStartRequest       : BOOL;
	bStopRequest        : BOOL;
	bHoldRequest        : BOOL;
	bResetRequest       : BOOL;
	bHomeAllRequest     : BOOL;
	bMachineFault       : BOOL;
	bStopExecute        : BOOL;

	// ── Program loader ───────────────────────────────────────────────────────
	ProgramCall         : E_Programs;
	eHmiProgramRequest  : E_Programs;
	bProgramDone        : BOOL;
	nHomeAllSeq         : INT;
	nHomeYSeq           : INT;
	nHomeXSeq           : INT;
	nHomeZSeq           : INT;
	bYHomeDone          : BOOL;
	bXHomeDone          : BOOL;
	bZHomeDone          : BOOL;

	// ── NCI / NC ─────────────────────────────────────────────────────────────
	bExecuteNCProgram   : BOOL := FALSE;
	sPrgName            : STRING[255] := 'C:\ProgramData\Beckhoff\TwinCAT\Mc\Nci\Profile_Cut_HeartPlaque.NC';
	sCurrentProgram     : STRING;
	out_stItpToPlc      : NCTOPLC_NCICHANNEL_REF;
	CNC_stItpToPlc      : NCTOPLC_NCICHANNEL_REF;
	fbStringTrimmer     : FB_StringTrimmer;

	// ── Polling timer ────────────────────────────────────────────────────────
	tPollingTimerTP     : TP;
	tPollingTimerTOF    : TOF;
	bPollingPulse       : BOOL;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bInitEvent THEN
    bInitEvent := FALSE;
    fbMessage.CreateEx(TC_Events.CNC_Events.X_Home_Start, 0);
END_IF
IF bSendEvent THEN
    bSendEvent := FALSE;
    fbMessage.Send(0);
END_IF

StateManager();
WatchdogTimer();

// Polling Timer
tPollingTimerTP(IN := NOT tPollingTimerTOF.Q, PT := T#100MS);
tPollingTimerTOF(IN := tPollingTimerTP.Q, PT := T#100MS);
bPollingPulse := tPollingTimerTP.Q;

// WatchdogTimer();

// Axis Gearing Triggers
rtrigAxisNotGeared(CLK := Y_MC_OUT.bPowerStatus AND NOT Y_MC_OUT.bGearInDone);
rGearInTrigger(CLK  := bGearInTrigger);
rGearOutTrigger(CLK := bGearOutTrigger);

trigAxisEnable(CLK := stHMI_In.bAxisEnable);

M_HMI_In();
M_HMI_Out();
M_LimitSwitchLogic();
M_Motion();

// FB_NCI — PackML Unit interface
fbNCI(
    eRequestedState      := eRequestedState,
    sPrgName             := sPrgName,
    bEnable              := bAxisEnable,
    bStop                := bStopExecute,
    stX                  := X_Ref,
    stY                  := Y_Ref,
    stZ                  := Z_Ref,
    sLoadedProgram       => sCurrentProgram,
    out_stItpToPlc       => CNC_stItpToPlc,
    bEnableDustCollector => bEnableDustCollector);

bAllAxesReady := Y_MC_OUT.bPowerStatus AND Y2_MC_OUT.bPowerStatus
              AND X_MC_OUT.bPowerStatus AND Z_MC_OUT.bPowerStatus;
bAllAxesHomed := Y_Ref.Status.Homed AND Y2_Ref.Status.Homed
              AND X_Ref.Status.Homed AND Z_Ref.Status.Homed;

M_ProgramLoader();
M_Inputs();
M_Outputs();
]]></ST>
    </Implementation>
    <Folder Name="State Machine" Id="{0b1f1a18-1b70-4bbe-9d05-f55371677c43}" />
    <Method Name="M_CoEStatus" Id="{425e84ec-496b-44e5-be31-8d117bba9219}">
      <Declaration><![CDATA[METHOD M_CoEStatus : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbYAxisCoEStatus(
	sNetId:= sAMSNetID , 
	nSlaveAddr:= 1003, 
	nSubIndex:= 2, 
	nIndex:= 16#F900, 
	pDstBuf:= ADR(nYDriveTemp), 
	cbBufLen:= SIZEOF(nYDriveTemp), 
	bExecute:= bPollingPulse, 
	tTimeout:= , 
	bBusy=> , 
	bError=> , 
	nErrId=> , 
	cbRead=> );
    
fbY2AxisCoEStatus(
	sNetId:= sAMSNetID , 
	nSlaveAddr:= 1004, 
	nSubIndex:= 2, 
	nIndex:= 16#F900, 
	pDstBuf:= ADR(nY2DriveTemp), 
	cbBufLen:= SIZEOF(nY2DriveTemp), 
	bExecute:= bPollingPulse, 
	tTimeout:= , 
	bBusy=> , 
	bError=> , 
	nErrId=> , 
	cbRead=> );
    
fbXAxisCoEStatus(
	sNetId:= sAMSNetID , 
	nSlaveAddr:= 1005, 
	nSubIndex:= 2, 
	nIndex:= 16#F900, 
	pDstBuf:= ADR(nXDriveTemp), 
	cbBufLen:= SIZEOF(nXDriveTemp), 
	bExecute:= bPollingPulse, 
	tTimeout:= , 
	bBusy=> , 
	bError=> , 
	nErrId=> , 
	cbRead=> );
    
fbZAxisCoEStatus(
	sNetId:= sAMSNetID , 
	nSlaveAddr:= 1006, 
	nSubIndex:= 2, 
	nIndex:= 16#F900, 
	pDstBuf:= ADR(nZDriveTemp), 
	cbBufLen:= SIZEOF(nZDriveTemp), 
	bExecute:= bPollingPulse, 
	tTimeout:= , 
	bBusy=> , 
	bError=> , 
	nErrId=> , 
	cbRead=> );]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HMI_In" Id="{44e46d1f-70c1-489a-bb58-f47ff09f9573}">
      <Declaration><![CDATA[METHOD M_HMI_In : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Home All Axes
bHomeAllRequest := stHMI_In.bHomeAll;

// Direct Home, force all axes to zero and "calibrated" for testing
bDirectHome		:= stHMI_In.bDirectHome;
// Trigger axis enable button toggle but don't allow it to overwrite the program controlled axis enable

IF trigAxisEnable.Q THEN
    bAxisEnable := NOT bAxisEnable; // Simplified toggle
END_IF

// Trigger Y coupling
bGearInTrigger := stHMI_In.bCoupleYAxes;
bGearOutTrigger := stHMI_In.bDecoupleAxes;

// 2. Production Requests
bStartRequest := stHMI_In.bStart;
bStopRequest := stHMI_In.bStop;
bHoldRequest := stHMI_In.bHold;
bResetRequest := stHMI_In.bReset;

// Axis Reset

bAxisReset := stHMI_In.bReset;

// Axis Jogging 

// NC Program Name

fbStringTrimmer(
                TriggerSequence:=stHMI_In.bInitiateNCProgramSelect,
                TrimLeft:=0, //3,
                TrimRight:=0, //3,
                STR:=stHMI_In.sPrgName,
                sString => sPrgName     );   
                
// Dust Collector
bEnableDustCollectorPB := stHMI_In.bEnableDustCollectorPB;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HMI_Out" Id="{8184d617-9b8a-4d2f-b43d-c3baf3e0a16e}">
      <Declaration><![CDATA[METHOD M_HMI_Out : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Limit and Homing Switch Mapping

stHMI_Out.bY1HomeSwitch := bYHomingSwitch;	
stHMI_Out.bY2HomeSwitch := bY2HomingSwitch;
stHMI_Out.bYLimitSwitch := bYLimitSwitch;	
stHMI_Out.bXHomeSwitch := bXHomingSwitch;
stHMI_Out.bXLimitSwitch := bXLimitSwitch;	
stHMI_Out.bZHomeSwitch  := bZHomingSwitch;
stHMI_Out.bYAxesCoupled := Y2_Ref.Status.Coupled;

// CoE Read EL7041 Drive Temps
stHMI_Out.nYDriveTemp   := nYDriveTemp;
stHMI_Out.nY2DriveTemp  := nY2DriveTemp;
stHMI_Out.nXDriveTemp   := nXDriveTemp;
stHMI_Out.nZDriveTemp   := nZDriveTemp;

//
stHMI_Out.bAllAxesReady	:= bAllAxesReady;

// Main State machine status
stHMI_Out.eCurrentState := eCurrentState;

// Pass Axis Ref info to HMI

stHMI_Out.stYRef  := Y_Ref;
stHMI_Out.stY2Ref := Y2_Ref;
stHMI_Out.stXRef  := X_Ref;
stHMI_Out.stZRef  := Z_Ref;

stHMI_Out.fActPosX:= LREAL_TO_REAL(X_Ref.NcToPlc.ActPos);
stHMI_Out.fActPosY:= LREAL_TO_REAL(Y_Ref.NcToPlc.ActPos);
stHMI_Out.fActPosY2:= LREAL_TO_REAL(Y2_Ref.NcToPlc.ActPos);
stHMI_Out.fActPosZ:= LREAL_TO_REAL(Z_Ref.NcToPlc.ActPos);

stHMI_Out.sCurrentProgramSelected := sCurrentProgram;







]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Inputs" Id="{08630c8a-d5b0-46e1-a791-1de7a6b0a230}">
      <Declaration><![CDATA[METHOD M_Inputs : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Homing Switch Inputs

bYHomingSwitch	:= i_bYHomingSwitch;	
bY2HomingSwitch	:= i_bY2HomingSwitch;	
bXHomingSwitch	:= i_bXHomingSwitch;	
bZHomingSwitch	:= i_bZHomingSwitch;

// Limit Switch Inputs

bYLimitSwitch	:= i_bYLimitSwitch;
bXLimitSwitch	:= i_bXLimitSwitch;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_LimitSwitchLogic" Id="{384c08ae-1c78-4a89-be5c-44432c41d4bb}">
      <Declaration><![CDATA[METHOD M_LimitSwitchLogic : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Limit Switch Logic // Ignore "Home sensors" while running home routines. otherwise use Homing sensors to trigger a limit switch stop

IF ProgramCall <> eNull THEN    
    bYNegativeLimit  := FALSE;
    bY2NegativeLimit := FALSE;
    bXNegativeLimit  := FALSE;
    bZPositiveLimit  := FALSE;
    bYStopTrigger(CLK:= bYLimitSwitch);
    bXStopTrigger(CLK:=bXLimitSwitch);
    bZStopTrigger(CLK:= FALSE);    
ELSE
    bYNegativeLimit := bYHomingSwitch;
    bY2NegativeLimit := bY2HomingSwitch;
    bXNegativeLimit := bXHomingSwitch;
    bZPositiveLimit := bZHomingSwitch;
    //Stop Triggers
    bYStopTrigger(CLK:=bYNegativeLimit OR bY2NegativeLimit OR bYLimitSwitch);
    bXStopTrigger(CLK:=bXNegativeLimit OR bXLimitSwitch);
    bZStopTrigger(CLK:=bZPositiveLimit);    
END_IF

// Limit Switch Rising Edge trigger to trigger MC_Stop when first active]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Motion" Id="{9ac27425-a044-42a2-a070-79369b8c40bd}">
      <Declaration><![CDATA[METHOD M_Motion : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Motion Calls


// Call Axis Status Action

Y_Ref.ReadStatus();
Y2_Ref.ReadStatus();
X_Ref.ReadStatus();
Z_Ref.ReadStatus();
M_CoEStatus();

Y_Motion( 
			Ref:= Y_Ref,
            bGearingEnabled := TRUE,
            SlaveRef:= Y2_Ref,
		  	Motion_In := Y_MC_IN,
		  	Motion_Out => Y_MC_OUT,
            bJogEnable:= stHMI_In.bJogEnable AND Y_Ref.NcToPlc.CoupleState = 1,
            eJogMode:= stHMI_In.eJogMode,
			fJogPosition:= stHMI_In.fJogPosition,
			fJogVelocity:= stHMI_In.fJogVelocity,
            bJogPositive := stHMI_In.bYJogPositive,
            bJogNegative := stHMI_In.bYJogNegative,
            bStopAxis := bStopExecute OR bYStopTrigger.Q,
            bResetAxis := bAxisReset,
			bHomingInput := bYHomingSwitch,
			eHomingMode := eHomingMode,
			bPositiveLimitSwitch := bYLimitSwitch,
            bNegativeLimitSwitch := bYNegativeLimit OR bY2NegativeLimit,
			bHomeExecute := bHomeY,
			bDirectHomeExecute:= bDirectHome,
            bSetPosExecute := stHMI_In.bSetPosExecute,
			fSetPosition :=	2500.00						
                                                                            );
                                        

							
Y2_Motion( 
			Ref:= Y2_Ref,
            bGearingEnabled := FALSE,
            SlaveRef:= Y2_Ref,
		  	Motion_In := Y2_MC_IN,
		  	Motion_Out => Y2_MC_OUT,
            bJogEnable:= stHMI_In.bJogEnable AND Y2_Ref.NcToPlc.CoupleState = 3,
            eJogMode:= stHMI_In.eJogMode,
			fJogPosition:= stHMI_In.fJogPosition,
			fJogVelocity:= stHMI_In.fJogVelocity,
            bJogPositive := stHMI_In.bYJogPositive,
            bJogNegative := stHMI_In.bYJogNegative,
            bStopAxis := bStopExecute OR bYStopTrigger.Q,
            bResetAxis := bAxisReset AND (Y2_Ref.NcToPlc.CoupleState = 0) ,
			bHomingInput := bY2HomingSwitch,
			eHomingMode := eHomingMode,
			bPositiveLimitSwitch := bYLimitSwitch,
            bNegativeLimitSwitch := bY2NegativeLimit OR bYNegativeLimit,
			bHomeExecute := bHomeY2,
			bDirectHomeExecute:= bDirectHome,
            bSetPosExecute := stHMI_In.bSetPosExecute,
			fSetPosition :=	2500.00								);
						
X_Motion( 
			Ref:= X_Ref,
            bGearingEnabled := FALSE,
            SlaveRef:= X_Ref,
		  	Motion_In := X_MC_IN,
		  	Motion_Out => X_MC_OUT,
            bJogEnable:= stHMI_In.bJogEnable,
            eJogMode:= stHMI_In.eJogMode,
			fJogPosition:= stHMI_In.fJogPosition,
			fJogVelocity:= stHMI_In.fJogVelocity,
            bJogPositive := stHMI_In.bXJogPositive,
            bJogNegative := stHMI_In.bXJogNegative,
            bStopAxis := bStopExecute OR bXStopTrigger.Q,
            bResetAxis := bAxisReset,
			bHomingInput := bXHomingSwitch,
			eHomingMode := eHomingMode,
			bPositiveLimitSwitch := bXLimitSwitch,
            bNegativeLimitSwitch := bXNegativeLimit,
			bHomeExecute := bHomeX,
			bDirectHomeExecute:= bDirectHome,
            bSetPosExecute := stHMI_In.bSetPosExecute,
			fSetPosition :=1285.00									);
							
Z_Motion( 
			Ref:= Z_Ref,
            bGearingEnabled := FALSE,
            SlaveRef:= Z_Ref,
		  	Motion_In := Z_MC_IN,
		  	Motion_Out => Z_MC_OUT ,
            bJogEnable:= stHMI_In.bJogEnable,
            eJogMode:= stHMI_In.eJogMode,
			fJogPosition:= stHMI_In.fJogPosition,
			fJogVelocity:= stHMI_In.fJogVelocity,
            bJogPositive := stHMI_In.bZJogPositive,
            bJogNegative := stHMI_In.bZJogNegative,
            bStopAxis := bStopExecute OR bZStopTrigger.Q,
            bResetAxis := bAxisReset,
			bHomingInput := bZHomingSwitch,
			eHomingMode := eHomingMode,
            bPositiveLimitSwitch := bZPositiveLimit,
            bNegativeLimitSwitch := FALSE,
			bHomeExecute := bHomeZ,
			bDirectHomeExecute:= bDirectHome,
            bSetPosExecute := stHMI_In.bSetPosExecute,
			fSetPosition := -212.69);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Outputs" Id="{8e119a18-dfec-4aa6-9ce4-524b96118a96}">
      <Declaration><![CDATA[METHOD M_Outputs : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Dust Collector Relay Output
q_bEnableDustCollector := bEnableDustCollector OR bEnableDustCollectorPB;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PRG_HomeAll" Id="{ee6f6b0e-a0da-4f4d-b48c-cd57411a7327}">
      <Declaration><![CDATA[METHOD M_PRG_HomeAll : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Execute homing on all axes simultaneously
// If there is an error during any Axis homing, continue with all other axes but return and error message of some sort i.e "X axis failed to Home" or something similar

CASE nHomeAllSeq OF
		 		
0:
   eHomingMode := MC_DefaultHoming;
   M_PRG_HomeAll := FALSE;
   bYHomeDone := M_PRG_HomeY();
   IF bYHomeDone THEN
     nHomeAllSeq:=10;
   END_IF
10:
   bXHomeDone := M_PRG_HomeX();
   IF bXHomeDone THEN
       nHomeAllSeq:=20;
   END_IF
20:
   bZHomeDone := M_PRG_HomeZ();
   IF bZHomeDone THEN
       nHomeAllSeq:=30;
   END_IF
30:
    M_PRG_HomeAll := bYHomeDone AND bXHomeDone AND bZHomeDone;  
	
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PRG_HomeX" Id="{97f5fa8e-2f8e-4532-8af3-4209f47af5d2}">
      <Declaration><![CDATA[METHOD M_PRG_HomeX : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[


CASE nHomeXSeq OF
		 		

	0:
		fbMessage.CreateEx(TC_Events.CNC_Events.X_Home_Start, 0); // "X Homing Started"
	    eHomingMode := MC_DefaultHoming;
        M_PRG_HomeX := FALSE;
		//bProgramDone := FALSE;
		bAxisEnable:=TRUE;
		nHomeXSeq :=10;	
	
	10:
	
		IF X_MC_OUT.bPowerStatus THEN
			
			bHomeX := TRUE;
			nHomeXSeq:=20;
		
		ELSE

			nHomeXSeq:=0;		
		
		END_IF
	
	20:
		IF X_MC_OUT.bAxisHomed THEN
			
			bHomeX:= FALSE;
			nHomeXSeq:=30;
		
		END_IF
		
	30:
		
		//bAxisEnable:=FALSE;
		nHomeXSeq:=0;
		//bProgramDone := TRUE;
        M_PRG_HomeX := TRUE;



END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PRG_HomeY" Id="{9d66eb1b-b3bd-4c00-adc7-ac7d6db7eec3}">
      <Declaration><![CDATA[METHOD M_PRG_HomeY : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[


CASE eHomeYSeq OF
		 		

INIT_HOME:
		fbMessage.CreateEx(TC_Events.CNC_Events.Y_Home_Start, 0);	// "Y Homing Started"
        eHomingMode := MC_DefaultHoming;
        M_PRG_HomeY:= FALSE;
		//bProgramDone := FALSE;
		bAxisEnable:=TRUE;
        bGearOutExecute:=FALSE;
        bGearInExecute:=FALSE;
        eHomeYSeq:=GEAR_IN;
        
GEAR_IN:        

        bGearInExecute := TRUE;
        IF Y_Ref.NcToPlc.CoupleState = 1 AND Y2_Ref.NcToPlc.CoupleState = 3 THEN     
            eHomeYSeq :=POWER_ON;
		END_IF
			
	
POWER_ON:

	    // Home Both Axes Together
		IF Y_MC_OUT.bPowerStatus THEN
			
			bHomeY := TRUE;
			eHomeYSeq:=CHECK_HOMED;
		
		ELSE

			eHomeYSeq:=INIT_HOME;		
		
		END_IF
	
CHECK_HOMED:

		IF Y_MC_OUT.bAxisHomed AND Y_Ref.Status.Homed THEN
			
			bHomeY:= FALSE;
			eHomeYSeq:=HOME_Y1;
		
		END_IF
        
HOME_Y1:
        // Decouple Axes for individual Homing
        
        //Y1 Homing
        bGearInExecute := FALSE;
        bGearOutExecute:= TRUE;
        IF Y_MC_OUT.bPowerStatus AND Y_Ref.NcToPlc.CoupleState = 0 THEN
			bHomeY := TRUE;
			eHomeYSeq:=Y1_HOMED;
        ELSE
            bAxisEnable:=TRUE;
            bAxisReset:=TRUE;
            eHomeYSeq:=HOME_Y1;
        END_IF
        
Y1_HOMED:
     
        IF Y_MC_OUT.bAxisHomed AND Y_Ref.Status.Homed THEN
			
			bHomeY:= FALSE;
			eHomeYSeq:=HOME_Y2;
		
		END_IF

HOME_Y2:
        // Y2 Homing
       IF Y2_MC_OUT.bPowerStatus AND Y2_Ref.NcToPlc.CoupleState = 0 THEN
			
			bHomeY2 := TRUE;
			eHomeYSeq:=Y2_HOMED;
        ELSE
            bAxisEnable:=TRUE;
            bAxisReset:=TRUE;
            eHomeYSeq:=HOME_Y2;
        END_IF
        
Y2_HOMED:
      
        IF Y2_MC_OUT.bAxisHomed AND Y2_Ref.Status.Homed THEN
			
			bHomeY2:= FALSE;
			eHomeYSeq:= RE_GEAR;
		
		END_IF
        

RE_GEAR:
        bGearOutExecute:=FALSE;
        bGearInExecute:=TRUE;
        IF Y_Ref.NcToPlc.CoupleState = 1 AND Y2_Ref.NcToPlc.CoupleState = 3 THEN
            eHomeYSeq:=HOME_COMPLETE;      
		END_IF
        
        
HOME_COMPLETE:
		
		//bAxisEnable:=FALSE;
		eHomeYSeq:=INIT_HOME;
		//bProgramDone := TRUE;
        M_PRG_HomeY:= TRUE;
        
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PRG_HomeZ" Id="{5ffc7e1c-953c-49bd-8560-22b8849ba64d}">
      <Declaration><![CDATA[METHOD M_PRG_HomeZ : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[


CASE nHomeZSeq OF
		 		

	0:
		fbMessage.CreateEx(TC_Events.CNC_Events.Z_Home_Start, 0); // "Z Homing Started"
	    eHomingMode := MC_DefaultHoming;
        M_PRG_HomeZ := FALSE;
		//bProgramDone := FALSE;
		bAxisEnable:=TRUE;
		nHomeZSeq :=10;	
	
	10:
	
		IF Z_MC_OUT.bPowerStatus THEN
			
			bHomeZ := TRUE;
			nHomeZSeq:=20;
		
		ELSE

			nHomeZSeq:=0;		
		
		END_IF
	
	20:
		IF Z_MC_OUT.bAxisHomed THEN
			
			bHomeZ:= FALSE;
			nHomeZSeq:=30;
		
		END_IF
		
	30:
		
		//bAxisEnable:=FALSE;
		nHomeZSeq:=0;
		//bProgramDone := TRUE;
        M_PRG_HomeZ := TRUE;




END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PRG_Null" Id="{7673609a-8435-42cc-80b7-800836ad57b0}">
      <Declaration><![CDATA[METHOD M_PRG_Null : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nHomeAllSeq:=0;
eHomeYSeq:=INIT_HOME;
nHomeXSeq:=0;
nHomeZSeq:=0;
//bProgramDone:= FALSE;
bHomeX:=FALSE;
bHomeY:=FALSE;
bHomeY2:=FALSE;
bHomeZ:=FALSE;
//bAxisEnable:= FALSE;

/////////////////////////////////]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProgramLoader" Id="{9271de0b-a532-40f5-a91f-ed88e7e00954}">
      <Declaration><![CDATA[METHOD M_ProgramLoader : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
IF bProgramDone THEN
	
	ProgramCall := eNull;

END_IF


CASE ProgramCall OF	
	
	eNull:
	
        bProgramDone:=FALSE;
	    bProgramDone :=	M_PRG_Null();

	eHomeAll:
    
	    bProgramDone:=FALSE;
		bProgramDone := M_PRG_HomeAll();
	
	eHomeY:
	
		bProgramDone:=FALSE;
		bProgramDone := M_PRG_HomeY();
	
	eHomeX:
	
		bProgramDone:=FALSE;
		bProgramDone := M_PRG_HomeX();	
	
	eHomeZ:
	
		bProgramDone:=FALSE;
		bProgramDone := M_PRG_HomeZ();

END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="StateManager" Id="{c2803ebc-fe8b-4d7d-9f60-807288fd38fc}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD StateManager : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ============================================================================
//  StateManager  —  PackML Controller
//  Drives eRequestedState only. Never writes eCurrentState in the CASE.
//  bAllSynced is evaluated POST-CASE so eRequestedState is always current.
// ============================================================================

// ── 0. GLOBAL OVERRIDES ──────────────────────────────────────────────────────
IF bMachineFault OR bHandshakeTimeout THEN
    IF eRequestedState <> E_MachineState.ABORTING
    AND eRequestedState <> E_MachineState.ABORTED THEN
        eRequestedState := E_MachineState.ABORTING;
    END_IF
END_IF

IF bStopRequest
AND eRequestedState <> E_MachineState.STOPPING
AND eRequestedState <> E_MachineState.STOPPED
AND eRequestedState <> E_MachineState.ABORTING
AND eRequestedState <> E_MachineState.ABORTED THEN
    bStopRequest    := FALSE;
    eRequestedState := E_MachineState.STOPPING;
END_IF

// ── 1. STATE MACHINE ─────────────────────────────────────────────────────────
CASE eRequestedState OF

    E_MachineState.STOPPED:
        IF bResetRequest THEN
            bResetRequest   := FALSE;
            eRequestedState := E_MachineState.RESETTING;
        END_IF

    E_MachineState.RESETTING:
        IF bAllSynced AND NOT bMachineFault THEN
            eRequestedState := E_MachineState.IDLE;
        END_IF

    E_MachineState.IDLE:
        IF bHomeAllRequest AND (ProgramCall = eNull) THEN
            bProgramDone := FALSE;
            ProgramCall  := E_Programs.eHomeAll;
        END_IF
        IF bStartRequest AND bAllAxesHomed AND (ProgramCall = eNull) THEN
            bStartRequest   := FALSE;
            eRequestedState := E_MachineState.STARTING;
        END_IF

    E_MachineState.STARTING:
        IF bAllSynced THEN
            eRequestedState := E_MachineState.EXECUTE;
        END_IF

    E_MachineState.EXECUTE:
        bExecuteNCProgram := TRUE;
        IF bAllSynced THEN
            bExecuteNCProgram := FALSE;
            eRequestedState   := E_MachineState.COMPLETING;
        ELSIF bHoldRequest THEN
            bHoldRequest    := FALSE;
            eRequestedState := E_MachineState.HOLDING;
        END_IF

    E_MachineState.HOLDING:
        IF bAllSynced THEN
            eRequestedState := E_MachineState.HELD;
        END_IF

    E_MachineState.HELD:
        IF bStartRequest THEN
            bStartRequest   := FALSE;
            eRequestedState := E_MachineState.UNHOLDING;
        END_IF

    E_MachineState.UNHOLDING:
        IF bAllSynced THEN
            eRequestedState := E_MachineState.EXECUTE;
        END_IF

    E_MachineState.COMPLETING:
        IF bAllSynced THEN
            eRequestedState := E_MachineState.COMPLETE;
        END_IF

    E_MachineState.COMPLETE:
        IF bResetRequest OR bStartRequest THEN
            bResetRequest   := FALSE;
            bStartRequest   := FALSE;
            eRequestedState := E_MachineState.RESETTING;
        END_IF

    E_MachineState.STOPPING:
        IF bAllSynced THEN
            eRequestedState := E_MachineState.STOPPED;
        END_IF

    E_MachineState.ABORTING:
        IF bAllSynced THEN
            eRequestedState := E_MachineState.ABORTED;
        END_IF

    E_MachineState.ABORTED:
        bExecuteNCProgram := FALSE;
        IF bResetRequest AND NOT bMachineFault AND NOT bHandshakeTimeout THEN
            bResetRequest   := FALSE;
            eRequestedState := E_MachineState.RESETTING;
        END_IF

END_CASE

// ── 2. POST-PROCESSING ───────────────────────────────────────────────────────
// eRequestedState is fully updated above before any of these evaluate.

// bAllSynced: follower must be working on current request AND report done.
// ★ AND additional followers here:
bAllSynced := (fbNCI.eActiveRequest = eRequestedState AND fbNCI.bStateDone);

// Diagnostic: which follower is blocking
// ★ Add additional followers here:
sBlockedBy := '';
IF NOT (fbNCI.eActiveRequest = eRequestedState AND fbNCI.bStateDone) THEN
    sBlockedBy := 'NCI';
END_IF

// Watchdog: fires if any follower stuck longer than T#30S
tonWatchdog(IN := NOT bAllSynced AND eRequestedState <> E_MachineState.EXECUTE, PT := T#30S);
IF tonWatchdog.Q THEN
    bHandshakeTimeout := TRUE;
    sErrorMsg         := CONCAT('Watchdog: ', sBlockedBy);
END_IF

// HMI mirror
eCurrentState := eRequestedState;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="WatchdogTimer" Id="{bcf58919-6e3c-435d-9b5d-123a5f386c35}" FolderPath="State Machine\">
      <Declaration><![CDATA[METHOD WatchdogTimer : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Watchdog reset — call this to clear a timeout after fault is resolved
IF bResetRequest THEN
    bHandshakeTimeout := FALSE;
    tonWatchdog(IN := FALSE);
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>