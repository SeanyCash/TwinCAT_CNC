<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="FB_PackML_SubBase" Id="{5f35c648-e761-4b66-9a02-87599159345f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PackML_SubBase
VAR_IN_OUT
    IF_Sub  : ST_SubInterface;  // Shared interface with Main
END_VAR
VAR
    ePrevRequest    : E_PackMLState;    // Detects when Main sends a new request
    tBusyStart      : TIME;             // For BusyTimeMs diagnostics
END_VAR

//  Base function block that every submodule EXTENDS.
//  Handles the Idle→Busy→Done/Error lifecycle automatically.
//  Submodule FBs override the M_Execute_* methods with their real logic.
//
//  USAGE — in your submodule FB declaration:
//      FUNCTION_BLOCK FB_Spindle EXTENDS FB_PackML_SubBase
//
//  Then override only the state methods you care about.
//  Any state you don't override auto-completes (reports Done immediately).
//
//  Paste into: POU > Add > Function Block
// ============================================================================]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================================
//  DETECT NEW REQUEST FROM MAIN
// ============================================================================
IF IF_Sub.Request <> E_PackMLState.Idle
AND IF_Sub.Request <> ePrevRequest THEN
    // New request arrived — transition to Busy and call entry logic
    ePrevRequest        := IF_Sub.Request;
    IF_Sub.Status       := E_SubStatus.Busy;
    IF_Sub.ErrorCode    := 0;
    IF_Sub.ErrorText    := '';
    tBusyStart          := TIME();
    M_OnEntry(IF_Sub.Request);
END_IF

// ============================================================================
//  EXECUTE CURRENT REQUEST  (only while Busy)
// ============================================================================
IF IF_Sub.Status = E_SubStatus.Busy THEN
//    IF_Sub.BusyTimeMs := DWORD_TO_UDINT(DWORD(TIME_TO_DWORD(TIME()) - TIME_TO_DWORD(tBusyStart)));
    M_Execute(IF_Sub.Request);
END_IF

// ============================================================================
//  ACKNOWLEDGE: Main set Request back to Idle → we reset Status to Idle
// ============================================================================
IF IF_Sub.Request = E_PackMLState.Idle
AND IF_Sub.Status = E_SubStatus.Done THEN
    IF_Sub.Status     := E_SubStatus.Idle;
    IF_Sub.BusyTimeMs := 0;
    ePrevRequest      := E_PackMLState.Idle;
    M_OnExit();
END_IF]]></ST>
    </Implementation>
    <Folder Name="Default State Handlers" Id="{b2473b2c-233a-4f1c-ab00-b8642e4d9992}" />
    <Folder Name="Helpers" Id="{15460199-e4c2-4e3c-aa55-15041b85f381}" />
    <Method Name="M_Execute" Id="{49a13b69-3c81-4c5f-9104-28ddaf7de4a4}">
      <Declaration><![CDATA[METHOD PROTECTED M_Execute : BOOL
VAR_INPUT
	eReq : E_PackMLState;
END_VAR

// called every cycle while Busy
//  Routes to the appropriate state handler.
//  Override individual M_Execute_* methods in the subclass.
// ============================================================================]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE eReq OF
    E_PackMLState.Resetting  : M_Execute_Resetting();
    E_PackMLState.Starting   : M_Execute_Starting();
    E_PackMLState.Execute    : M_Execute_Execute();
    E_PackMLState.Completing : M_Execute_Completing();
    E_PackMLState.Holding    : M_Execute_Holding();
    E_PackMLState.Unholding  : M_Execute_Unholding();
    E_PackMLState.Stopping   : M_Execute_Stopping();
    E_PackMLState.Aborting   : M_Execute_Aborting();
    ELSE
        // States with no sub action (Idle, Held, Complete, Stopped, Aborted)
        // auto-complete so Main is never waiting on them.
        M_SetDone();
END_CASE]]></ST>
      </Implementation>
    </Method>
