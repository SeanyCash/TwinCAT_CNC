    <Method Name="M_OnEntry" Id="{a6d68263-fdc8-42a9-9b00-3f04d3db0528}">
      <Declaration><![CDATA[METHOD PROTECTED M_OnEntry : BOOL
VAR_INPUT
	eReq : E_PackMLState;
END_VAR

// called once when a new request arrives
//  Override in subclass to do one-shot setup (start timers, init FBs, etc.)
// ============================================================================
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default: nothing. Override in subclass.]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_OnExit" Id="{b57fa811-0018-4dc8-bfad-1b9dda6ff3bf}">
      <Declaration><![CDATA[METHOD PROTECTED M_OnExit : BOOL
VAR_INPUT
END_VAR

// called once when Main acknowledges Done
//  Override in subclass for cleanup.
// ============================================================================]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default: nothing. Override in subclass.]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetDone" Id="{216133da-6ad8-4790-8a10-4edfee26ae31}" FolderPath="Helpers\">
      <Declaration><![CDATA[METHOD PROTECTED M_SetDone : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF_Sub.Status := E_SubStatus.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetError" Id="{9f5ec5c7-b05f-4cc0-8a20-7a6ded35a7b2}" FolderPath="Helpers\">
      <Declaration><![CDATA[METHOD PROTECTED M_SetError : BOOL
VAR_INPUT
	iCode : DINT;
    sText : STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF_Sub.Status    := E_SubStatus.Error;
IF_Sub.ErrorCode := iCode;
IF_Sub.ErrorText := sText;]]></ST>
      </Implementation>
    </Method>
