  <DUT Name="E_PML_State" Id="{46620210-87b3-4e37-af63-cb8a280fcdb4}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
TYPE E_PML_State :
(
    Undefined := 0,
    Stopped,
    Resetting,
    Idle,
    Starting,
    Execute,
    Completing,
    Complete,
    Holding,
    Held,
    Unholding,
    Stopping,
    Aborting,
    Aborted
) := Stopped;
END_TYPE
]]></Declaration>
