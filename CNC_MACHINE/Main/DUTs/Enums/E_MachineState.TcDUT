  <DUT Name="E_MachineState" Id="{46620210-87b3-4e37-af63-cb8a280fcdb4}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_MachineState :
(
	RESETTING,
	IDLE,
	STARTING,
	EXECUTE,
	HOLDING,
	UNHOLDING,
	HELD,
	COMPLETING,
	COMPLETE,
	STOPPED,
	STOPPING,
	ABORTING,
	ABORTED
) := IDLE;
END_TYPE
]]></Declaration>
